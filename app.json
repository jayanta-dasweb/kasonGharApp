{
  "expo": {
    "name": "Kason Ghar",
    "slug": "kasonghar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kason-ghar-logo.jpg",
    "scheme": "kasonghar",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kasonghar.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.kasonghar.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kason-ghar-logo.jpg",
          "resizeMode": "contain",
          "backgroundColor": "#F7F1E8"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
